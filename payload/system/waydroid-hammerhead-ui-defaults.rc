# Hammerhead: apply validated Android UI defaults once per Waydroid data set.

on property:sys.boot_completed=1
    start waydroid_hammerhead_ui_defaults

service waydroid_hammerhead_ui_defaults /system/bin/sh /system/bin/waydroid-hammerhead-ui-defaults.sh
    class late_start
    user root
    group root system
    disabled
    oneshot
