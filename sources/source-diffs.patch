@@ -266,6 +270,37 @@ int gralloc_lock_ycbcr(gralloc_module_t const* module,
                 ycbcr->cstride = ystride;
                 ycbcr->chroma_step = 2;
                 break;
+            case HAL_PIXEL_FORMAT_NV12_ENCODEABLE:
+#ifdef VENUS_COLOR_FORMAT
+                ystride = VENUS_Y_STRIDE(COLOR_FMT_NV12, hnd->width);
+                cstride = VENUS_UV_STRIDE(COLOR_FMT_NV12, hnd->width);
+#else
+                ystride = cstride = hnd->width;
+#endif
+                /*
+                 * Codec2 locks the full logical crop (for example 1920x1080),
+                 * while this legacy private handle may describe an allocation
+                 * with Venus-aligned geometry (for example 1920x1088).
+                 *
+                 * The hammerhead camera writes VU chroma directly after the
+                 * logical Y rows. Using the aligned Y scanline count therefore
+                 * advances the chroma pointer by eight 1920-byte rows and
+                 * produces eight zero chroma rows at the end of a 1080p frame.
+                 */
+                logical_height =
+                        (t == 0 && h > 0 && h <= hnd->height)
+                        ? h : hnd->height;
+
+                ycbcr->y  = (void*)hnd->base;
+                ycbcr->cr =
+                        (void*)(hnd->base + ystride * logical_height);
+                ycbcr->cb =
+                        (void*)(hnd->base + ystride * logical_height + 1);
+                ycbcr->ystride = ystride;
+                ycbcr->cstride = cstride;
+                ycbcr->chroma_step = 2;
+                break;
+
             case HAL_PIXEL_FORMAT_YCbCr_420_SP_VENUS:
                 ystride = cstride = hnd->width;
                 ycbcr->y  = (void*)hnd->base;

