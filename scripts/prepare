#!/usr/bin/python3
# SPDX-License-Identifier: MIT
"""Prepare the pinned Android 11 images for Hammerhead Waydroid.

The final Hammerhead integration is installed directly into system.img and
vendor.img while Waydroid is stopped. system.img keeps its original size;
vendor.img is expanded by exactly 128 MiB. Proprietary Qualcomm files are
never shipped by this RPM: they are derived locally from the installed
Hammerhead adaptation and from the checksum-pinned graphics archive supplied
by the device owner.

No loop device or filesystem mount is used. ext4 files are read/written with
debugfs and vendor.img is expanded with e2fsck/resize2fs.
"""

import argparse
import hashlib
import json
import os
import pwd
import shutil
import stat
import subprocess
