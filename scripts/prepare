GNSS_EXEC_CONTEXT = "u:object_r:hal_gnss_default_exec:s0"


class PrepError(Exception):
    pass


def sha256_file(path):
    h = hashlib.sha256()
    with open(str(path), "rb") as stream:
        while True:
            chunk = stream.read(1024 * 1024)
            if not chunk:
                break
            h.update(chunk)
    return h.hexdigest()


def run(args, capture=False, check=True):
    proc = subprocess.run(
        [str(x) for x in args],
        stdout=subprocess.PIPE if capture else None,
        stderr=subprocess.STDOUT if capture else None,
        universal_newlines=True,
        check=False,
    )
    if check and proc.returncode != 0:
        out = proc.stdout or ""
        raise PrepError("command failed rc=%d: %s\n%s" % (
            proc.returncode, " ".join(str(x) for x in args), out))
    return (proc.stdout or "").strip() if capture else ""


def require_tool(name):
    path = shutil.which(name)
    if not path:
        raise PrepError("required tool is missing: %s" % name)
    return path


def container_state():
    try:
        return run(["lxc-info", "-P", "/var/lib/waydroid/lxc", "-n", "waydroid", "-sH"], True, False).strip() or "STOPPED"
    except Exception:
        return "STOPPED"


def ensure_stopped():
    state = container_state()
    if state in ("RUNNING", "FROZEN"):
        raise PrepError("Waydroid is %s; stop it before preparing Android images" % state)


def resolve_image(link):
    path = Path(os.path.realpath(str(link)))
    if not path.is_file():
        raise PrepError("missing Waydroid image: %s" % link)
    return path


def image_has_loop(path):
    out = run(["losetup", "-j", os.path.realpath(str(path))], True, False)
    return bool(out.strip())


def verify_stock_image(path, expected_sha, expected_size, label):
    size = path.stat().st_size
    if size != expected_size:
        raise PrepError("%s image size=%d, expected pristine size=%d" % (label, size, expected_size))
    digest = sha256_file(path)
    if digest != expected_sha:
        raise PrepError("%s image SHA-256=%s, expected pristine=%s" % (label, digest, expected_sha))


def debugfs(image, command, write=False, check=True):
    args = [require_tool("debugfs")]
    if write:
        args.append("-w")
    args += ["-R", command, str(image)]
    out = run(args, True, False)
    # debugfs historically returns success for a number of command-level errors;
    # reject the common fatal forms explicitly and rely on post-write verification.
    fatal_markers = (
        "File not found by ext2_lookup",
        "Filesystem opened read/only",
        "Command not found",
        "while opening filesystem",
    )
    if check and any(marker in out for marker in fatal_markers):
        raise PrepError("debugfs failed: %s\n%s" % (command, out))
    return out


def debugfs_exists(image, path):
    out = debugfs(image, "stat %s" % path, check=False)
    return "File not found by ext2_lookup" not in out and "Inode:" in out


def debugfs_dump(image, path, host):
    host = Path(host)
    if host.exists():
        host.unlink()
    out = debugfs(image, "dump %s %s" % (path, host), check=False)
    if not host.is_file():
        raise PrepError("cannot dump %s from %s: %s" % (path, image, out))


def debugfs_mkdirs(image, path):
    current = ""
    for part in Path(path).parts:
        if part == "/":
            continue
        current += "/" + part
        if not debugfs_exists(image, current):
            debugfs(image, "mkdir %s" % current, write=True)
            if not debugfs_exists(image, current):
                raise PrepError("failed to create directory in image: %s" % current)


def debugfs_set_context(image, path, context):
    with tempfile.NamedTemporaryFile(prefix="hammerhead-selinux-", delete=False) as tmp:
        tmp.write(context.encode("ascii") + b"\0")
        tmp_path = tmp.name
    try:
        debugfs(image, "ea_set -f %s %s security.selinux" % (tmp_path, path), write=True)
        verify = tempfile.NamedTemporaryFile(prefix="hammerhead-selinux-check-", delete=False)
        verify.close()
        try:
            Path(verify.name).unlink()
            out = debugfs(image, "ea_get -f %s %s security.selinux" % (verify.name, path), check=False)
            if not Path(verify.name).is_file():
                raise PrepError("failed to read SELinux xattr for %s: %s" % (path, out))
            got = Path(verify.name).read_bytes().rstrip(b"\0").decode("ascii")
            if got != context:
                raise PrepError("SELinux xattr mismatch for %s: %r != %r" % (path, got, context))
        finally:
            try:
                Path(verify.name).unlink()
            except FileNotFoundError:
                pass
    finally:
        try:
            Path(tmp_path).unlink()
        except FileNotFoundError:
            pass


def debugfs_replace(image, image_path, host_path, digest, mode, uid, gid, context=None):
    host_path = Path(host_path)
    if sha256_file(host_path) != digest:
        raise PrepError("source SHA-256 mismatch for %s" % host_path)
    debugfs_mkdirs(image, str(Path(image_path).parent))
    if debugfs_exists(image, image_path):
        debugfs(image, "rm %s" % image_path, write=True)
    debugfs(image, "write %s %s" % (host_path, image_path), write=True)
    debugfs(image, "set_inode_field %s mode 0%o" % (image_path, stat.S_IFREG | mode), write=True)
    debugfs(image, "set_inode_field %s uid %d" % (image_path, uid), write=True)
    debugfs(image, "set_inode_field %s gid %d" % (image_path, gid), write=True)
    if context is not None:
        debugfs_set_context(image, image_path, context)
    else:
        # A newly allocated inode should have no SELinux xattr. Ensure a stale
        # one was not inherited by an unusual debugfs implementation.
        attrs = debugfs(image, "ea_list %s" % image_path, check=False)
        if "security.selinux" in attrs:
            debugfs(image, "ea_rm %s security.selinux" % image_path, write=True)
    with tempfile.NamedTemporaryFile(prefix="hammerhead-verify-", delete=False) as tmp:
        verify_path = Path(tmp.name)
    try:
        verify_path.unlink()
        debugfs_dump(image, image_path, verify_path)
        got = sha256_file(verify_path)
        if got != digest:
            raise PrepError("image write verification failed for %s: %s" % (image_path, got))
    finally:
        try:
            verify_path.unlink()
        except FileNotFoundError:
            pass
    info = debugfs(image, "stat %s" % image_path)
    if ("Mode:  %04o" % mode) not in info:
        raise PrepError("mode verification failed for %s\n%s" % (image_path, info))
    if ("User: %5d" % uid) not in info and ("User:     %d" % uid) not in info:
        # debugfs field width varies between e2fsprogs releases; fall back to a
        # compact whitespace-insensitive check.
        compact = " ".join(info.split())
        if "User: %d" % uid not in compact:
            raise PrepError("uid verification failed for %s\n%s" % (image_path, info))
    compact = " ".join(info.split())
    if "Group: %d" % gid not in compact:
        raise PrepError("gid verification failed for %s\n%s" % (image_path, info))


def safe_tar_name(name):
    p = Path(name)
    return not p.is_absolute() and ".." not in p.parts


def extract_open_payload(dst):
    if not OPEN_ARCHIVE.is_file() or not OPEN_ARCHIVE_SHA_FILE.is_file():
        raise PrepError("packaged open payload is missing")
    expected_archive = OPEN_ARCHIVE_SHA_FILE.read_text().split()[0]
    actual_archive = sha256_file(OPEN_ARCHIVE)
    if actual_archive != expected_archive:
        raise PrepError("open payload archive checksum mismatch")
    with tarfile.open(str(OPEN_ARCHIVE), "r:gz") as tf:
        for member in tf.getmembers():
            if not safe_tar_name(member.name):
                raise PrepError("unsafe open payload member: %s" % member.name)
            if not member.isfile():
                continue
            target = dst / member.name
            target.parent.mkdir(parents=True, exist_ok=True)
            src = tf.extractfile(member)
            if src is None:
                raise PrepError("cannot read open payload member %s" % member.name)
            with open(str(target), "wb") as out:
                shutil.copyfileobj(src, out, 1024 * 1024)
            src.close()
    manifest = dst / "SHA256SUMS"
    if not manifest.is_file():
        raise PrepError("open payload manifest missing")
    for line in manifest.read_text().splitlines():
        if not line.strip():
            continue
        digest, rel = line.split(None, 1)
        path = dst / rel.strip()
        if not path.is_file() or sha256_file(path) != digest:
            raise PrepError("open payload verification failed: %s" % rel.strip())
    for rel, digest in OPEN_REQUIRED_VENDOR.items():
        path = dst / rel
        if not path.is_file() or sha256_file(path) != digest:
            raise PrepError("required open vendor payload identity mismatch: %s" % rel)
    return actual_archive


def locate_graphics_archive():
    candidates = []
    env = os.environ.get("WAYDROID_HAMMERHEAD_GRAPHICS_ARCHIVE")
    if env:
        candidates.append(Path(env))
    candidates.extend([
        PROPRIETARY_DIR / GRAPHICS_NAME,
        Path("/home/defaultuser/Downloads") / GRAPHICS_NAME,
        Path("/home/defaultuser") / GRAPHICS_NAME,
    ])
    mismatches = []
    for path in candidates:
        if not path.is_file():
            continue
        digest = sha256_file(path)
        if digest == GRAPHICS_SHA:
            return path
        mismatches.append("%s=%s" % (path, digest))
    if mismatches:
        raise PrepError("found graphics archive with wrong checksum: %s" % "; ".join(mismatches))
    raise PrepError("missing proprietary graphics archive %s (expected SHA-256 %s)" % (GRAPHICS_NAME, GRAPHICS_SHA))


def extract_graphics(archive, dst):
    with tarfile.open(str(archive), "r:*") as tf:
        members = tf.getmembers()
        for wanted in GRAPHICS_FILES:
            matches = []
            suffix = wanted.strip("/")
            for member in members:
                normalized = member.name.lstrip("./")
                if member.isfile() and (normalized == suffix or normalized.endswith("/" + suffix)):
                    matches.append(member)
            if len(matches) != 1:
                raise PrepError("graphics archive expected one %s, found %d" % (wanted, len(matches)))
            src = tf.extractfile(matches[0])
            if src is None:
                raise PrepError("cannot read graphics archive member %s" % matches[0].name)
            target = dst / wanted
            target.parent.mkdir(parents=True, exist_ok=True)
            target.write_bytes(src.read())
            src.close()
    eglsub = dst / "vendor/lib/egl/eglsubAndroid.so"
    data = bytearray(eglsub.read_bytes())
    if len(data) <= 0x8e1c:
        raise PrepError("eglsubAndroid.so is too small for compatibility patch")
    data[0x8e14:0x8e1c] = bytes.fromhex("010000000d000000")
    eglsub.write_bytes(data)
    if sha256_file(eglsub) != FINAL_EGLSUB_SHA:
        raise PrepError("patched eglsubAndroid.so checksum mismatch")


def copy_private_jpeg(dst):
    for name, digest in JPEG_SOURCES.items():
        candidates = [Path("/system/vendor/lib") / name, Path("/system/lib") / name]
        src = next((p for p in candidates if p.is_file()), None)
        if src is None:
            raise PrepError("missing Hammerhead JPEG blob on Sailfish adaptation: %s" % name)
        if sha256_file(src) != digest:
            raise PrepError("unexpected Hammerhead JPEG blob identity: %s" % src)
        target = dst / "vendor/lib" / name
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(str(src), str(target))


def copy_private_gnss(dst):
    for source_name, rel in GNSS_FILES:
        src = Path(source_name)
        if not src.is_file():
            raise PrepError("missing Hammerhead GNSS/QMI blob: %s" % src)
        expected = GNSS_ANCHORS.get(rel)
        if expected and sha256_file(src) != expected:
            raise PrepError("unexpected Hammerhead GNSS/QMI blob identity: %s" % src)
        target = dst / rel
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(str(src), str(target))


def derive_system_files(system_image, dst):
    dst.mkdir(parents=True, exist_ok=True)
    libegl_stock = dst / "libEGL.stock.so"
    debugfs_dump(system_image, "/system/lib/libEGL.so", libegl_stock)
    data = bytearray(libegl_stock.read_bytes())
    if hashlib.sha256(data).hexdigest() != STOCK_LIBEGL_SHA:
        raise PrepError("unexpected pristine libEGL.so")
    if data[0xCCC0:0xCCC4] != bytes.fromhex("d8f81870"):
        raise PrepError("stock libEGL blob-cache guard bytes do not match")
    if data[0x11F9A:0x11F9E] != bytes.fromhex("d0f8cc21"):
        raise PrepError("stock libEGL query-route guard bytes do not match")
    data[0xCCC0:0xCCC4] = bytes.fromhex("00f048b8")
    data[0x11F9A:0x11F9E] = bytes.fromhex("d0f8c821")
    libegl = dst / "libEGL.so"
    libegl.write_bytes(data)
    if sha256_file(libegl) != FINAL_LIBEGL_SHA:
        raise PrepError("derived libEGL.so checksum mismatch")

    sf_stock = dst / "libsurfaceflinger.stock.so"
    debugfs_dump(system_image, "/system/lib/libsurfaceflinger.so", sf_stock)
    data = bytearray(sf_stock.read_bytes())
    if hashlib.sha256(data).hexdigest() != STOCK_SURFACEFLINGER_SHA:
        raise PrepError("unexpected pristine libsurfaceflinger.so")
    # Reproduce the exact final proven SurfaceFlinger binary from the pinned
    # pristine image. The first five ranges are the retained EGLConfig fixes;
    # the final range is the Stage-7 CPU-fence fix.
    sf_patches = (
        (0x1164E0, "2e",   "38"),
        (0x1164E2, "0024", "79a4"),
        (0x1164F8, "0c9e", "0126"),
        (0x1166C8, "00bf", "3830"),
        (0x1166CB, "bf",   "00"),
        (0x117BBA, "18b3", "23e0"),
    )

    for offset, before_hex, after_hex in sf_patches:
        before = bytes.fromhex(before_hex)
        after = bytes.fromhex(after_hex)

        if len(before) != len(after):
            raise PrepError(
                "invalid SurfaceFlinger patch length at 0x%x" % offset
            )

        end = offset + len(before)

        if data[offset:end] != before:
            raise PrepError(
                "stock SurfaceFlinger guard bytes do not match at 0x%x"
                % offset
            )

        data[offset:end] = after
    sf = dst / "libsurfaceflinger.so"
    sf.write_bytes(data)
    if sha256_file(sf) != FINAL_SURFACEFLINGER_SHA:
        raise PrepError("derived libsurfaceflinger.so checksum mismatch")
    return libegl, sf


def derive_vendor_build_prop(vendor_image, dst):
    stock = dst / "build.prop.stock"
    debugfs_dump(vendor_image, "/build.prop", stock)
    raw = stock.read_bytes()
    if hashlib.sha256(raw).hexdigest() != STOCK_VENDOR_BUILD_PROP_SHA:
        raise PrepError("unexpected pristine vendor build.prop")
    text = raw.decode("utf-8")
    if "import /vendor/waydroid.prop" in text:
        raise PrepError("pristine vendor build.prop unexpectedly contains Waydroid import")
    target = dst / "build.prop"
    target.write_bytes((text + VENDOR_IMPORT_BLOCK).encode("utf-8"))
    if sha256_file(target) != FINAL_VENDOR_BUILD_PROP_SHA:
        raise PrepError("derived vendor build.prop checksum mismatch")
    return target


def camera_data_home():
    try:
        entry = pwd.getpwuid(100000)
        home = Path(entry.pw_dir)
        uid, gid = entry.pw_uid, entry.pw_gid
    except KeyError:
        home = Path("/home/defaultuser")
        uid = gid = 100000
    return home / ".local/share/waydroid/data", uid, gid


def ensure_camera_symlinks():
    data, uid, gid = camera_data_home()
    missing = []
    current = data
    while not current.exists() and str(current) != "/":
        missing.append(current)
        current = current.parent
    data.mkdir(parents=True, exist_ok=True)
    for directory in reversed(missing):
        try:
            os.chown(str(directory), uid, gid)
        except OSError:
            pass
    for name in ("cam_socket1", "cam_socket2"):
        path = data / name
        target = "host_qcamera/%s" % name
        if path.is_symlink():
            if os.readlink(str(path)) != target:
                raise PrepError("camera socket symlink has unexpected target: %s" % path)
            continue
        if path.exists():
            raise PrepError("camera socket bridge path exists but is not our symlink: %s" % path)
        os.symlink(target, str(path))


def run_fsck(path):
    require_tool("e2fsck")
    proc = subprocess.run(["e2fsck", "-fy", str(path)], check=False)
    # e2fsck 0=no errors, 1=errors corrected. Values >=2 require intervention.
    if proc.returncode not in (0, 1):
        raise PrepError("e2fsck failed for %s with rc=%d" % (path, proc.returncode))


def resize_vendor(vendor):
    if vendor.stat().st_size != STOCK_VENDOR_SIZE:
        raise PrepError("vendor.img is not pristine size before expansion")
    run_fsck(vendor)
    os.truncate(str(vendor), FINAL_VENDOR_SIZE)
    run([require_tool("resize2fs"), str(vendor)])
    if vendor.stat().st_size != FINAL_VENDOR_SIZE:
        raise PrepError("vendor.img file size did not reach expected final size")


def install_system(system, stage):
    libegl, sf = derive_system_files(system, stage / "derived-system")
    netd = SYSTEM_PAYLOAD_DIR / "netd.rc"
    direct = SYSTEM_PAYLOAD_DIR / "waydroid-netd-direct-connect.sh"
    if not netd.is_file() or sha256_file(netd) != FINAL_NETD_SHA:
        raise PrepError("packaged final netd.rc identity mismatch")
    if not direct.is_file() or sha256_file(direct) != FINAL_DIRECT_CONNECT_SHA:
        raise PrepError("packaged direct-connect helper identity mismatch")
    debugfs_replace(system, "/system/lib/libEGL.so", libegl, FINAL_LIBEGL_SHA,
                    0o644, 0, 0, SYSTEM_LIB_CONTEXT)
    debugfs_replace(system, "/system/lib/libsurfaceflinger.so", sf,
                    FINAL_SURFACEFLINGER_SHA, 0o644, 0, 0, SYSTEM_LIB_CONTEXT)
    debugfs_replace(system, "/system/etc/init/netd.rc", netd, FINAL_NETD_SHA,
                    0o644, 0, 0, None)
    debugfs_replace(system, "/system/bin/waydroid-netd-direct-connect.sh", direct,
                    FINAL_DIRECT_CONNECT_SHA, 0o755, 0, 2000, None)


def vendor_specs(open_root, private_root, build_prop):
    specs = []
    def add(rel, src, digest, mode=0o644, uid=0, gid=0, context=VENDOR_FILE_CONTEXT):
        image_rel = rel[7:] if rel.startswith("vendor/") else rel
        specs.append(("/" + image_rel, Path(src), digest, mode, uid, gid, context))

    add("vendor/lib/hw/hwcomposer.waydroid.so", open_root / "vendor/lib/hw/hwcomposer.waydroid.so",
        OPEN_REQUIRED_VENDOR["vendor/lib/hw/hwcomposer.waydroid.so"])
    add("vendor/lib/hw/camera.hammerhead.so", open_root / "vendor/lib/hw/camera.hammerhead.so",
        OPEN_REQUIRED_VENDOR["vendor/lib/hw/camera.hammerhead.so"])
    add("vendor/lib/hw/gralloc.msm8974.so", open_root / "vendor/lib/hw/gralloc.msm8974.so",
        OPEN_REQUIRED_VENDOR["vendor/lib/hw/gralloc.msm8974.so"], context=SAME_PROCESS_CONTEXT)
    for rel in ("vendor/lib/libmmcamera_interface.so", "vendor/lib/libmmjpeg_interface.so", "vendor/lib/libqomx_core.so"):
        add(rel, open_root / rel, OPEN_REQUIRED_VENDOR[rel])
    add("vendor/bin/hw/android.hardware.gnss@1.0-service",
        open_root / "vendor/bin/hw/android.hardware.gnss@1.0-service",
        OPEN_REQUIRED_VENDOR["vendor/bin/hw/android.hardware.gnss@1.0-service"],
        mode=0o755, gid=2000, context=GNSS_EXEC_CONTEXT)
    add("vendor/lib/hw/android.hardware.gnss@1.0-impl.so",
        open_root / "vendor/lib/hw/android.hardware.gnss@1.0-impl.so",
        OPEN_REQUIRED_VENDOR["vendor/lib/hw/android.hardware.gnss@1.0-impl.so"])
    add("vendor/etc/init/android.hardware.gnss@1.0-service.rc",
        open_root / "vendor/etc/init/android.hardware.gnss@1.0-service.rc",
        OPEN_REQUIRED_VENDOR["vendor/etc/init/android.hardware.gnss@1.0-service.rc"],
        context=VENDOR_CONFIG_CONTEXT)
    add("vendor/etc/vintf/manifest/android.hardware.gnss@1.0.xml",
        open_root / "vendor/etc/vintf/manifest/android.hardware.gnss@1.0.xml",
        OPEN_REQUIRED_VENDOR["vendor/etc/vintf/manifest/android.hardware.gnss@1.0.xml"],
        context=VENDOR_CONFIG_CONTEXT)
    add("vendor/etc/media_profiles_V1_0.xml",
        open_root / "vendor/etc/media_profiles_V1_0.xml",
        OPEN_REQUIRED_VENDOR["vendor/etc/media_profiles_V1_0.xml"],
        context=VENDOR_CONFIG_CONTEXT)

    for rel in GRAPHICS_FILES:
        src = private_root / rel
        digest = sha256_file(src)
        add(rel, src, digest, context=SAME_PROCESS_CONTEXT)
    for name, digest in JPEG_SOURCES.items():
        rel = "vendor/lib/%s" % name
        add(rel, private_root / rel, digest)

    gps_rel = "vendor/lib/hw/gps.msm8974.so"
    gps_src = private_root / gps_rel
    gps_digest = sha256_file(gps_src)
    add(gps_rel, gps_src, gps_digest)
    add("vendor/lib/hw/gps.default.so", gps_src, gps_digest)
    seen = {gps_rel}
    for _src, rel in GNSS_FILES:
        if rel in seen:
            continue
        seen.add(rel)
        src = private_root / rel
        add(rel, src, sha256_file(src))

    specs.append(("/build.prop", build_prop, FINAL_VENDOR_BUILD_PROP_SHA,
                  0o600, 0, 0, VENDOR_FILE_CONTEXT))
    return specs


def install_vendor(vendor, stage, graphics):
    open_root = stage / "open"
    private_root = stage / "private"
    extract_open_payload(open_root)
    extract_graphics(graphics, private_root)
    copy_private_jpeg(private_root)
    copy_private_gnss(private_root)
    derived = stage / "derived-vendor"
    derived.mkdir(parents=True, exist_ok=True)
    build_prop = derive_vendor_build_prop(vendor, derived)
    resize_vendor(vendor)
    for image_path, source, digest, mode, uid, gid, context in vendor_specs(open_root, private_root, build_prop):
        debugfs_replace(vendor, image_path, source, digest, mode, uid, gid, context)


def key_hashes_ok(system, vendor):
    checks = [
        (system, "/system/lib/libEGL.so", FINAL_LIBEGL_SHA),
        (system, "/system/lib/libsurfaceflinger.so", FINAL_SURFACEFLINGER_SHA),
        (system, "/system/etc/init/netd.rc", FINAL_NETD_SHA),
        (system, "/system/bin/waydroid-netd-direct-connect.sh", FINAL_DIRECT_CONNECT_SHA),
        (vendor, "/lib/hw/hwcomposer.waydroid.so", OPEN_REQUIRED_VENDOR["vendor/lib/hw/hwcomposer.waydroid.so"]),
        (vendor, "/lib/hw/camera.hammerhead.so", OPEN_REQUIRED_VENDOR["vendor/lib/hw/camera.hammerhead.so"]),
        (vendor, "/lib/hw/gralloc.msm8974.so", OPEN_REQUIRED_VENDOR["vendor/lib/hw/gralloc.msm8974.so"]),
        (vendor, "/lib/egl/eglsubAndroid.so", FINAL_EGLSUB_SHA),
        (vendor, "/build.prop", FINAL_VENDOR_BUILD_PROP_SHA),
    ]
    with tempfile.TemporaryDirectory(prefix="hammerhead-keycheck-") as td:
        for idx, (image, path, digest) in enumerate(checks):
            out = Path(td) / str(idx)
            try:
                debugfs_dump(image, path, out)
            except PrepError:
                return False
            if sha256_file(out) != digest:
                return False
    return True


def load_state():
    try:
        return json.loads(STATE_FILE.read_text())
    except Exception:
        return None


def save_state(system, vendor, open_sha):
    state = {
        "schema": SCHEMA,
        "system": {
            "path": str(system),
            "size": system.stat().st_size,
            "sha256": sha256_file(system),
        },
        "vendor": {
            "path": str(vendor),
            "size": vendor.stat().st_size,
            "sha256": sha256_file(vendor),
        },
        "open_archive_sha256": open_sha,
        "graphics_archive_sha256": GRAPHICS_SHA,
    }
    STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
    tmp = STATE_FILE.with_name(".%s.%d" % (STATE_FILE.name, os.getpid()))
    tmp.write_text(json.dumps(state, sort_keys=True, indent=2) + "\n")
    os.chmod(str(tmp), 0o644)
    os.replace(str(tmp), str(STATE_FILE))
    return state


def state_matches(state, system, vendor):
    if not state or state.get("schema") != SCHEMA:
        return False
    try:
        return (
            state["system"]["path"] == str(system) and
            state["system"]["size"] == system.stat().st_size and
            state["system"]["sha256"] == sha256_file(system) and
            state["vendor"]["path"] == str(vendor) and
            state["vendor"]["size"] == vendor.stat().st_size and
            state["vendor"]["sha256"] == sha256_file(vendor) and
            state.get("graphics_archive_sha256") == GRAPHICS_SHA and
            key_hashes_ok(system, vendor)
        )
    except Exception:
        return False


def remove_legacy_runtime():
    if LEGACY_RUNTIME.is_dir():
        shutil.rmtree(str(LEGACY_RUNTIME))
    # config_android is package-generated in 0.2.0. The 0.3.0 configurator
    # permanently strips its include. Remove the stale fragment itself too.
    if LEGACY_CONFIG_ANDROID.is_file():
        LEGACY_CONFIG_ANDROID.unlink()


def prepare(defer_ok=False):
    ensure_stopped()
    try:
        system = resolve_image(SYSTEM_IMAGE_LINK)
        vendor = resolve_image(VENDOR_IMAGE_LINK)
    except PrepError:
        if defer_ok:
            print("%s: Waydroid images are not initialized; preparation deferred" % PACKAGE)
            return 0
        raise
    if image_has_loop(system) or image_has_loop(vendor):
        raise PrepError("Waydroid image loop attachment exists; reboot without starting Waydroid and retry")
    for tool in ("debugfs", "e2fsck", "resize2fs"):
        require_tool(tool)

    state = load_state()
    if state_matches(state, system, vendor):
        remove_legacy_runtime()
        ensure_camera_symlinks()
        print("%s: Android images already prepared" % PACKAGE)
        return 0

    # Without a valid state marker, mutate only exact pristine pinned images.
    # This makes an interrupted/partial preparation fail closed rather than
    # guessing which files or filesystem metadata were already changed.
    verify_stock_image(system, STOCK_SYSTEM_SHA, STOCK_SYSTEM_SIZE, "system")
    verify_stock_image(vendor, STOCK_VENDOR_SHA, STOCK_VENDOR_SIZE, "vendor")
    graphics = locate_graphics_archive()
    open_sha = sha256_file(OPEN_ARCHIVE)
    if open_sha != OPEN_ARCHIVE_SHA_FILE.read_text().split()[0]:
        raise PrepError("packaged open payload checksum mismatch")

    stage = Path(tempfile.mkdtemp(prefix=".hammerhead-image-prep-", dir="/home/waydroid"))
    try:
        install_system(system, stage)
        install_vendor(vendor, stage, graphics)
        run_fsck(system)
        run_fsck(vendor)
        if system.stat().st_size != STOCK_SYSTEM_SIZE:
            raise PrepError("system.img size changed unexpectedly")
        if vendor.stat().st_size != FINAL_VENDOR_SIZE:
            raise PrepError("vendor.img final size mismatch")
        if not key_hashes_ok(system, vendor):
            raise PrepError("final Android image key-file verification failed")
        save_state(system, vendor, open_sha)
        remove_legacy_runtime()
        ensure_camera_symlinks()
        print("%s: Android images prepared successfully" % PACKAGE)
        print("%s: system.img size=%d sha256=%s" % (PACKAGE, system.stat().st_size, sha256_file(system)))
        print("%s: vendor.img size=%d sha256=%s" % (PACKAGE, vendor.stat().st_size, sha256_file(vendor)))
        return 0
    finally:
        shutil.rmtree(str(stage), ignore_errors=True)


def status():
    print("package=%s schema=%d" % (PACKAGE, SCHEMA))
    print("container_state=%s" % container_state())
    state = load_state()
    print("state_file=%s" % ("present" if state else "missing"))
    for label, link in (("system", SYSTEM_IMAGE_LINK), ("vendor", VENDOR_IMAGE_LINK)):
        try:
            path = resolve_image(link)
            print("%s=%s size=%d sha256=%s" % (label, path, path.stat().st_size, sha256_file(path)))
        except PrepError:
            print("%s=missing" % label)
    print("legacy_runtime=%s" % ("present" if LEGACY_RUNTIME.is_dir() else "absent"))
    print("legacy_config_android=%s" % ("present" if LEGACY_CONFIG_ANDROID.is_file() else "absent"))
    return 0


def remove_generated():
    # Image changes are intentionally not reversed on RPM removal. Restoring
    # pristine images is an explicit re-extraction/setup operation.
    remove_legacy_runtime()
    return 0


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--ensure", action="store_true")
    parser.add_argument("--defer-ok", action="store_true")
    parser.add_argument("--status", action="store_true")
    parser.add_argument("--remove", action="store_true")
    args = parser.parse_args()
    if os.geteuid() != 0:
        raise PrepError("must run as root")
    if args.status:
        return status()
    if args.remove:
        return remove_generated()
    return prepare(args.defer_ok)


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except PrepError as exc:
        print("%s: ERROR: %s" % (PACKAGE, exc), file=sys.stderr)
        raise SystemExit(2)
    except KeyboardInterrupt:
        print("%s: interrupted" % PACKAGE, file=sys.stderr)
        raise SystemExit(130)
